{{! Campos editables de una pregunta. Se incluye dentro de cada tarjeta del panel del editor (sugerencias y reportes) }}
<input type="hidden" name="id" value="{{id}}">

<div class="ed-campo">
    <label for="pregunta-{{id}}">Pregunta</label>
    <input class="w3-input w3-border" type="text" id="pregunta-{{id}}" name="pregunta" maxlength="255" value="{{enunciado}}" required>
</div>

<div class="ed-campo">
    <label for="categoria-{{id}}">Categoría</label>
    <select class="w3-select w3-border" id="categoria-{{id}}" name="categoria_id" required>
        {{#categorias}}
            <option value="{{id}}" {{#seleccionada}}selected{{/seleccionada}}>{{nombre}}</option>
        {{/categorias}}
    </select>
</div>

<div class="ed-fila">
    <div class="ed-campo">
        <label for="correcta-{{id}}">✅ Respuesta correcta</label>
        <input class="w3-input w3-border" type="text" id="correcta-{{id}}" name="correcta" maxlength="150" value="{{correcta}}" required>
    </div>
    <div class="ed-campo">
        <label for="inc1-{{id}}">Incorrecta 1</label>
        <input class="w3-input w3-border" type="text" id="inc1-{{id}}" name="incorrecta1" maxlength="150" value="{{incorrecta1}}" required>
    </div>
    <div class="ed-campo">
        <label for="inc2-{{id}}">Incorrecta 2</label>
        <input class="w3-input w3-border" type="text" id="inc2-{{id}}" name="incorrecta2" maxlength="150" value="{{incorrecta2}}" required>
    </div>
    <div class="ed-campo">
        <label for="inc3-{{id}}">Incorrecta 3</label>
        <input class="w3-input w3-border" type="text" id="inc3-{{id}}" name="incorrecta3" maxlength="150" value="{{incorrecta3}}" required>
    </div>
</div>
