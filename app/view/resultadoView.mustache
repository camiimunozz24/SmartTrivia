<link rel="stylesheet" href="/public/css/partida.css">

<div class="partida-wrap">
    <div class="partida-card" style="--color-categoria: #475569;">
        <div class="partida-cabecera"><span>Fin de la partida</span></div>

        <div class="partida-cuerpo" style="text-align:center;">
            <div class="resultado-icono" id="resultado-icono"
                 data-motivo="{{#motivo_error}}error{{/motivo_error}}{{#motivo_tiempo}}error{{/motivo_tiempo}}{{#motivo_sin_preguntas}}fin{{/motivo_sin_preguntas}}">{{icono}}</div>
            <h2 class="resultado-titulo">{{titulo}}</h2>

            {{#motivo_tiempo}}<p class="resultado-texto">Tenías {{limite_segundos}} segundos para responder y se terminaron.</p>{{/motivo_tiempo}}
            {{#motivo_sin_preguntas}}<p class="resultado-texto">¡Respondiste todas las preguntas de todas las categorías! Impresionante.</p>{{/motivo_sin_preguntas}}

            {{#mostrar_correcta}}
                <p class="resultado-label">La pregunta era:</p>
                <p>{{pregunta}}</p>
                <p class="resultado-label">La respuesta correcta era:</p>
                <div class="resultado-correcta">{{correcta}}</div>
            {{/mostrar_correcta}}

            <p class="resultado-puntos">Sumaste {{puntaje}} {{puntos_texto}}</p>

            <div style="display:flex; justify-content:center; gap:16px; margin: 12px 0 20px; flex-wrap:wrap;">
                <span class="chip-puntaje" style="background:#f0fdf4; color:#166534; padding:6px 14px; border-radius:20px; font-weight:600;">
                    ✅ {{respuestas_correctas}} correctas
                </span>
                <span class="chip-puntaje" style="background:#eef2ff; color:#3730a3; padding:6px 14px; border-radius:20px; font-weight:600;">
                    ⚡ Mayor racha: {{mejor_racha}}
                </span>
                <span class="chip-puntaje" style="background:#fffbeb; color:#92400e; padding:6px 14px; border-radius:20px; font-weight:600;">
                    🔥 Racha diaria: {{racha_dias}} días ({{multiplicador_aplicado}})
                </span>
            </div>

            <div class="botones">
                <a href="/partida/iniciar" class="boton boton-primario">🎮 Jugar de nuevo</a>
                <a href="/home/show" class="boton boton-gris">🏠 Inicio</a>
            </div>
        </div>
    </div>
</div>
<script>
    (function () {
        try { sessionStorage.removeItem('st_respondio'); } catch (e) {}
        var motivo = document.getElementById('resultado-icono').dataset.motivo;
        if (motivo) { Sonidos.efecto(motivo); }
    })();
</script>