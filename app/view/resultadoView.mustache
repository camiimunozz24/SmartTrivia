<link rel="stylesheet" href="/public/css/partida.css">

<div class="partida-wrap">
    <div class="partida-card" style="--color-categoria: #475569;">
        <div class="partida-cabecera"><span>Fin de la partida</span></div>

        <div class="partida-cuerpo" style="text-align:center;">
            <div class="resultado-icono">{{icono}}</div>
            <h2 class="resultado-titulo">{{titulo}}</h2>

            {{#motivo_tiempo}}<p class="resultado-texto">Tenías {{limite_segundos}} segundos para responder y se terminaron.</p>{{/motivo_tiempo}}
            {{#motivo_sin_preguntas}}<p class="resultado-texto">¡Respondiste todas las preguntas de la categoría! Impresionante.</p>{{/motivo_sin_preguntas}}

            {{#mostrar_correcta}}
                <p class="resultado-label">La pregunta era:</p>
                <p>{{pregunta}}</p>
                <p class="resultado-label">La respuesta correcta era:</p>
                <div class="resultado-correcta">{{correcta}}</div>
            {{/mostrar_correcta}}

            <p class="resultado-puntos">Sumaste {{puntaje}} {{puntos_texto}}</p>

            <div class="botones">
                <a href="/partida/iniciar" class="boton boton-primario">🎮 Jugar de nuevo</a>
                <a href="/home/show" class="boton boton-gris">🏠 Inicio</a>
            </div>
        </div>
    </div>
</div>
