<link rel="stylesheet" href="/public/css/login.css">
<div class="w3-content login" style="max-width:450px">
    <div class="card-trivia-login w3-margin-top">
        <h2 class="w3-center">Iniciar sesión</h2>

        {{#registro_ok}}
            <div class="w3-panel w3-pale-green w3-leftbar w3-border-green">
                <p>¡Cuenta creada! Ya podés iniciar sesión.</p>
            </div>
        {{/registro_ok}}

        {{#error}}
            <div class="w3-panel w3-pale-red w3-leftbar w3-border-red">
                <p>{{error}}</p>
            </div>
        {{/error}}

        <form action="/login/login" method="post">
            <p>
                <label for="usuario">Usuario o email</label>
                <input class="w3-input w3-border" type="text" id="usuario" name="usuario" required autofocus>
            </p>
            <div class="w3-section">
                            <label for="password">Contraseña</label>
                            <div class="campo-password">
                                <input class="w3-input w3-border" type="password" id="password" name="password" required>
                                <button type="button" class="ojo" id="ojo" aria-label="Mostrar contraseña">
                                    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8S1 12 1 12z"/>
                                        <circle cx="12" cy="12" r="3"/>
                                    </svg>
                                </button>
                            </div>
                        </div>
            <button class="w3-button w3-blue w3-block" type="submit">Ingresar</button>
        </form>

        <p class="w3-center">¿No tenés cuenta? <a href="/registro">Registrate</a></p>
    </div>
</div>
<script>
  const campo = document.getElementById("password");
  const ojo = document.getElementById("ojo");
  ojo.addEventListener("click", () => {
    const mostrar = campo.type === "password";
    campo.type = mostrar ? "text" : "password";
    ojo.classList.toggle("visible", mostrar);
  });
</script>