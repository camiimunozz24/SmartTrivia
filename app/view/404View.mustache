<link rel="stylesheet" href="/public/css/login.css">
<link rel="stylesheet" href="/public/css/perfil.css">

<div class="w3-content perfil" style="max-width:760px">
    <div class="card-trivia-perfil w3-margin-top" style="text-align: center; padding: 30px 20px;">

        <!-- Cabecera de Error 404 -->
        <div class="perfil-cabecera" style="flex-direction: column; align-items: center; text-align: center;">
            <div class="perfil-avatar-placeholder" style="font-size: 40px; background-color: #f8d7da; color: #721c24; width: 80px; height: 80px; display: flex; align-items: center; justify-content: center; border-radius: 50%; margin-bottom: 15px;">
