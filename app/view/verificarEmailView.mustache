<link rel="stylesheet" href="/public/css/login.css">
<div class="w3-content registro" style="max-width:450px">
    <div class="card-trivia-registro w3-margin-top">
        <h2 class="w3-center">Verificá tu correo</h2>

        <div class="w3-panel w3-pale-blue w3-leftbar w3-border-blue">
            <p>Te enviamos un código de 8 caracteres a <strong>{{email}}</strong>. Ingresalo para activar tu cuenta en <strong>SmartTrivia</strong>.</p>
        </div>

        {{#error}}
            <div class="w3-panel w3-pale-red w3-leftbar w3-border-red">
                <p>{{error}}</p>
            </div>
        {{/error}}

        {{#aviso}}
            <div class="w3-panel w3-pale-green w3-leftbar w3-border-green">
                <p>{{aviso}}</p>
            </div>
        {{/aviso}}

        <form action="/registro/validarCodigo" method="post">
            <p>
                <label for="codigo">Código de verificación</label>
                <input class="w3-input w3-border w3-center" type="text" id="codigo" name="codigo"
                       maxlength="8" minlength="8" autocomplete="off" autocapitalize="characters"
                       spellcheck="false" placeholder="XXXXXXXX" required autofocus
                       style="font-size:28px;letter-spacing:8px;text-transform:uppercase;">
            </p>
            <button class="w3-button w3-green w3-block" type="submit">Verificar</button>
        </form>

        <form action="/registro/reenviarCodigo" method="post" class="w3-margin-top">
            <button id="btn-reenviar"
                    class="w3-button w3-blue w3-block"
                    type="submit"
                    data-espera="{{espera_segundos}}"
                    {{#en_espera}}disabled{{/en_espera}}>
                {{#en_espera}}Reenviar código ({{espera_segundos}}s){{/en_espera}}
                {{^en_espera}}Reenviar código{{/en_espera}}
            </button>
            <p id="texto-espera" class="w3-center" style="font-size:0.85rem; color:#64748b; margin:8px 0 0;{{^en_espera}} display:none;{{/en_espera}}">
                Podés solicitar un nuevo envío en <strong id="contador-segundos">{{espera_segundos}}</strong> segundos.
            </p>
        </form>

        <p class="w3-center w3-margin-top"><a href="/">Volver al inicio de sesión</a></p>
    </div>
</div>

<script>
    (function () {
        var btn = document.getElementById('btn-reenviar');
        var texto = document.getElementById('texto-espera');
        var span = document.getElementById('contador-segundos');
        if (!btn) { return; }

        var segundos = parseInt(btn.dataset.espera || '0', 10);
        if (isNaN(segundos) || segundos <= 0) { return; }

        var fin = Date.now() + segundos * 1000;

        function actualizar() {
            var restantes = Math.max(0, Math.ceil((fin - Date.now()) / 1000));
            if (restantes > 0) {
                btn.disabled = true;
                btn.textContent = 'Reenviar código (' + restantes + 's)';
                if (span) { span.textContent = restantes; }
                if (texto) { texto.style.display = 'block'; }
            } else {
                btn.disabled = false;
                btn.textContent = 'Reenviar código';
                if (texto) {
                    texto.style.display = 'block';
                    texto.style.color = '#15803d';
                    texto.textContent = 'Ya podés solicitar un nuevo envío del código.';
                }
                clearInterval(intervalo);
            }
        }

        actualizar();
        var intervalo = setInterval(actualizar, 250);
    })();
</script>
