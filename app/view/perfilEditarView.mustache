<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">
<link rel="stylesheet" href="/public/css/login.css">
<link rel="stylesheet" href="/public/css/registro.css">
<div class="w3-content registro" style="max-width:640px">
    <div class="card-trivia-registro w3-margin-top">
        <h2 class="w3-center">Editar perfil</h2>

        {{#error}}
            <div class="w3-panel w3-pale-red w3-leftbar w3-border-red">
                <p>{{error}}</p>
            </div>
        {{/error}}

        <form action="/perfil/guardar" method="post" enctype="multipart/form-data" id="form-registro">

            <section class="seccion">
                <h4 class="seccion-titulo"><span class="seccion-numero">1</span> Datos personales</h4>

                <div class="campo">
                    <label for="nombre_completo">Nombre completo</label>
                    <input class="w3-input w3-border" type="text" id="nombre_completo" name="nombre_completo" maxlength="100" value="{{nombre_completo}}" required autofocus>
                </div>

                <div class="fila">
                    <div class="campo">
                        <label for="fecha_nacimiento">Fecha de nacimiento</label>
                        <input class="w3-input w3-border" type="date" id="fecha_nacimiento" name="fecha_nacimiento" value="{{fecha_nacimiento}}" required>
                    </div>
                    <div class="campo">
                        <label for="genero">Género</label>
                        <select class="w3-select w3-border" id="genero" name="genero" required>
                            <option value="Masculino" {{#genero_masculino}}selected{{/genero_masculino}}>Masculino</option>
                            <option value="Femenino" {{#genero_femenino}}selected{{/genero_femenino}}>Femenino</option>
                            <option value="Prefiero no cargarlo" {{#genero_nocargado}}selected{{/genero_nocargado}}>Prefiero no cargarlo</option>
                        </select>
                    </div>
                </div>

                <div class="campo">
                    <label>Ubicación</label>
                    <div id="mapa"></div>
                    <input type="hidden" id="pais" name="pais" value="{{pais}}">
                    <input type="hidden" id="ciudad" name="ciudad" value="{{ciudad}}">
                    <p id="ubicacion-elegida">Ubicación actual: {{ciudad}}, {{pais}}. Para cambiarla, hacé zoom y clic en otra ciudad.</p>
                </div>

                <div class="campo">
                    <label for="foto">Foto de perfil</label>
                    {{#tiene_foto}}
                        <img src="/public/img/perfiles/{{foto_perfil}}" alt="Tu foto actual" style="width:80px;height:80px;border-radius:50%;object-fit:cover;display:block;margin:6px 0;">
                    {{/tiene_foto}}
                    <input class="w3-input w3-border" type="file" id="foto" name="foto" accept="image/jpeg,image/png,image/webp">
                    <p class="ayuda">Dejalo vacío para conservar la foto actual. JPG, PNG o WEBP. Máximo 2 MB.</p>
                </div>
            </section>

            <section class="seccion">
                <h4 class="seccion-titulo"><span class="seccion-numero">2</span> Datos de la cuenta</h4>

                <div class="fila">
                    <div class="campo">
                        <label for="usuario">Usuario</label>
                        <input class="w3-input w3-border" type="text" id="usuario" name="usuario" maxlength="50" value="{{usuario}}" required>
                    </div>
                    <div class="campo">
                        <label for="email">Email</label>
                        <input class="w3-input w3-border" type="email" id="email" value="{{email}}" disabled>
                        <p class="ayuda">El email no se puede cambiar.</p>
                    </div>
                </div>
            </section>

            <button class="w3-button w3-green w3-block" type="submit">Guardar cambios</button>
        </form>

        <form action="/perfil/cambiarPassword" method="post" class="w3-margin-top">
            <section class="seccion">
                <h4 class="seccion-titulo"><span class="seccion-numero">3</span> Cambiar contraseña</h4>

                <div class="campo">
                    <label for="password_actual">Contraseña actual</label>
                    <input class="w3-input w3-border" type="password" id="password_actual" name="password_actual" required>
                </div>
                <div class="fila">
                    <div class="campo">
                        <label for="password">Contraseña nueva</label>
                        <input class="w3-input w3-border" type="password" id="password" name="password" minlength="6" required>
                        <p class="ayuda">Mínimo 6 caracteres.</p>
                    </div>
                    <div class="campo">
                        <label for="confirmar_password">Repetir contraseña nueva</label>
                        <input class="w3-input w3-border" type="password" id="confirmar_password" name="confirmar_password" minlength="6" required>
                    </div>
                </div>
                <button class="w3-button w3-blue w3-block" type="submit">Cambiar contraseña</button>
            </section>
        </form>

        <p class="w3-center"><a href="/perfil/show">Cancelar y volver al perfil</a></p>
    </div>
</div>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script src="/public/js/registro-mapa.js"></script>
<script>
  // No permitir fechas de nacimiento futuras (ajustado a la hora local)
  const hoy = new Date();
  hoy.setMinutes(hoy.getMinutes() - hoy.getTimezoneOffset());
  document.getElementById("fecha_nacimiento").max = hoy.toISOString().split("T")[0];
</script>
