<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">
<link rel="stylesheet" href="/public/css/login.css">
<link rel="stylesheet" href="/public/css/registro.css">
<div class="w3-content registro" style="max-width:640px">
    <div class="card-trivia-registro w3-margin-top">
        <h2 class="w3-center">Crear cuenta</h2>

        {{#error}}
            <div class="w3-panel w3-pale-red w3-leftbar w3-border-red">
                <p>{{error}}</p>
            </div>
        {{/error}}

        <form action="/registro/registrar" method="post" enctype="multipart/form-data" id="form-registro">

            <section class="seccion">
                <h4 class="seccion-titulo"><span class="seccion-numero">1</span> Datos personales</h4>

                <div class="campo">
                    <label for="nombre_completo">Nombre completo</label>
                    <input class="w3-input w3-border" type="text" id="nombre_completo" name="nombre_completo" maxlength="100" required autofocus>
                </div>

                <div class="fila">
                    <div class="campo">
                        <label for="fecha_nacimiento">Fecha de nacimiento</label>
                        <input class="w3-input w3-border" type="date" id="fecha_nacimiento" name="fecha_nacimiento" required>
                    </div>
                    <div class="campo">
                        <label for="genero">Género</label>
                        <select class="w3-select w3-border" id="genero" name="genero" required>
                            <option value="" disabled selected>Elegí una opción</option>
                            <option value="Masculino">Masculino</option>
                            <option value="Femenino">Femenino</option>
                            <option value="Prefiero no cargarlo">Prefiero no cargarlo</option>
                        </select>
                    </div>
                </div>

                <div class="campo">
                    <label>Ubicación</label>
                    <div id="mapa"></div>
                    <input type="hidden" id="pais" name="pais">
                    <input type="hidden" id="ciudad" name="ciudad">
                    <p id="ubicacion-elegida">Hacé zoom y clic en tu ciudad. Todavía no elegiste una ubicación.</p>
                </div>

                <div class="campo">
                    <label for="foto">Foto de perfil</label>
                    <input class="w3-input w3-border" type="file" id="foto" name="foto" accept="image/jpeg,image/png,image/webp" required>
                    <p class="ayuda">JPG, PNG o WEBP. Máximo 2 MB.</p>
                </div>
            </section>

            <section class="seccion">
                <h4 class="seccion-titulo"><span class="seccion-numero">2</span> Datos de la cuenta</h4>

                <div class="fila">
                    <div class="campo">
                        <label for="usuario">Usuario</label>
                        <input class="w3-input w3-border" type="text" id="usuario" name="usuario" maxlength="50" required>
                    </div>
                    <div class="campo">
                        <label for="email">Email</label>
                        <input class="w3-input w3-border" type="email" id="email" name="email" maxlength="100" required>
                    </div>
                </div>

                <div class="fila">
                    <div class="campo">
                        <label for="password">Contraseña</label>
                        <div class="campo-password">
                            <input class="w3-input w3-border" type="password" id="password" name="password" minlength="6" required>
                            <button type="button" class="ojo" aria-label="Mostrar contraseña">
                                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8S1 12 1 12z"/>
                                    <circle cx="12" cy="12" r="3"/>
                                </svg>
                            </button>
                        </div>
                        <p class="ayuda">Mínimo 6 caracteres.</p>
                    </div>
                    <div class="campo">
                        <label for="confirmar_password">Repetir contraseña</label>
                        <div class="campo-password">
                            <input class="w3-input w3-border" type="password" id="confirmar_password" name="confirmar_password" minlength="6" required>
                            <button type="button" class="ojo" aria-label="Mostrar contraseña">
                                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8S1 12 1 12z"/>
                                    <circle cx="12" cy="12" r="3"/>
                                </svg>
                            </button>
                        </div>
                    </div>
                </div>
            </section>

            <button class="w3-button w3-green w3-block" type="submit">Registrarme</button>
        </form>

        <p class="w3-center">¿Ya tenés cuenta? <a href="/">Iniciá sesión</a></p>
    </div>
</div>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script src="/public/js/registro-mapa.js"></script>

<script>
  // No permitir fechas de nacimiento futuras (ajustado a la hora local)
  const hoy = new Date();
  hoy.setMinutes(hoy.getMinutes() - hoy.getTimezoneOffset());
  document.getElementById("fecha_nacimiento").max = hoy.toISOString().split("T")[0];

  // Visibilidad password
  document.querySelectorAll(".ojo").forEach((ojo) => {
    const campo = ojo.parentElement.querySelector("input");
    ojo.addEventListener("click", () => {
      const mostrar = campo.type === "password";
      campo.type = mostrar ? "text" : "password";
      ojo.classList.toggle("visible", mostrar);
    });
  });
</script>