<link rel="stylesheet" href="/public/css/home.css">

<div class="w3-content home" style="max-width:760px">

    <!-- Bienvenida y botones principales -->
    <div class="home-card home-hero w3-margin-top">
        <div class="home-icono">🧠</div>
        <h2>¡Hola{{#usuario}}, @{{usuario}}{{/usuario}}!</h2>
        {{#usuario}}<div class="home-puntaje" title="Puntos sumados en todas tus partidas">⭐ {{puntaje_total}} pts acumulados</div>{{/usuario}}
        <p class="home-subtitulo">Girá la ruleta, respondé contra el reloj y subí en el ranking.</p>

        <div class="home-acciones" style="display:flex; justify-content:center; gap:12px; flex-wrap:wrap; margin-top:8px;">
            {{#en_curso}}
                <a href="/partida/pregunta" class="w3-button w3-green w3-large w3-round-large home-btn-jugar">▶ Continuar partida</a>
            {{/en_curso}}
            {{^en_curso}}
                <a href="/partida/iniciar" class="w3-button w3-green w3-large w3-round-large home-btn-jugar">🎮 Jugar</a>
            {{/en_curso}}
            <a href="/ranking/show" class="w3-button w3-blue w3-large w3-round-large home-btn-ranking" style="font-weight:600; padding:12px 24px;">🏆 Ver Rankings</a>
        </div>
    </div>

    <!-- Racha Diaria de Acceso -->
    <div class="home-card" style="background:#fffbeb; border:1px solid #fde68a;">
        <div style="display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:12px;">
            <div style="display:flex; align-items:center; gap:12px;">
                <span style="font-size:32px;">🔥</span>
                <div>
                    <h4 style="margin:0; color:#92400e; font-size:1.05rem; font-weight:700;">
                        Racha diaria: {{racha_dias}} {{#tiene_racha_dias}}días seguidos{{/tiene_racha_dias}}{{^tiene_racha_dias}}días{{/tiene_racha_dias}}
                    </h4>
                    <p style="margin:2px 0 0; font-size:0.875rem; color:#b45309;">
                        Entrá cada día y acertá al menos una pregunta para multiplicar tus puntos en cada acierto.
                    </p>
                </div>
            </div>
            <span style="background:#f59e0b; color:#ffffff; padding:6px 16px; border-radius:999px; font-weight:700; font-size:0.95rem;">
                Multiplicador: {{multiplicador}}
            </span>
        </div>
    </div>

    <!-- Listado de partidas recientes -->
    <div class="home-card">
        <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:8px; margin-bottom:12px;">
            <h4 class="home-titulo" style="margin:0;">Tus últimas partidas</h4>
            <a href="/perfil/historial" style="color:#1e56a0; text-decoration:none; font-size:0.875rem; font-weight:600;">Ver tu historial completo →</a>
        </div>

        {{#hay_partidas}}
            <div style="overflow-x:auto;">
                <table class="w3-table w3-striped w3-bordered" style="font-size:0.9rem;">
                    <thead>
                        <tr style="background:#f8fafc; color:#475569; font-size:0.8rem; text-transform:uppercase;">
                            <th>Fecha</th>
                            <th>Categoría</th>
                            <th>Puntos</th>
                            <th>Aciertos</th>
                            <th>Mayor Racha</th>
                            <th>Resultado</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#ultimas_partidas}}
                            <tr>
                                <td style="color:#64748b; font-size:0.85rem;">{{fecha}}</td>
                                <td><span style="border-left:3px solid {{color}}; padding-left:6px; font-weight:500;">{{categoria}}</span></td>
                                <td><strong style="color:#0f2a52;">+{{puntaje}}</strong></td>
                                <td>✅ {{respuestas_correctas}}</td>
                                <td>⚡ {{mejor_racha}}</td>
                                <td><span class="w3-tag w3-round w3-light-gray" style="font-size:0.75rem;">{{motivo_texto}}</span></td>
                            </tr>
                        {{/ultimas_partidas}}
                    </tbody>
                </table>
            </div>
        {{/hay_partidas}}

        {{^hay_partidas}}
            <p style="color:#64748b; margin:8px 0 0; font-size:0.95rem;">Todavía no jugaste ninguna partida. ¡Hacé clic en <strong>Jugar</strong> para empezar!</p>
        {{/hay_partidas}}
    </div>

    <!-- Cómo se juega -->
    <div class="home-card">
        <h4 class="home-titulo">¿Cómo se juega?</h4>
        <div class="home-pasos">
            <div class="home-paso">
                <span class="home-paso-num">1</span>
                <h3>Girá la ruleta</h3>
                <p>Te toca una categoría al azar.</p>
            </div>
            <div class="home-paso">
                <span class="home-paso-num">2</span>
                <h3>Respondé a tiempo</h3>
                <p>Tenés {{limite_segundos}} segundos por pregunta.</p>
            </div>
            <div class="home-paso">
                <span class="home-paso-num">3</span>
                <h3>Sumá puntos y rachas</h3>
                <p>Cada acierto suma según dificultad (100 a 200 pts) potenciado por tu racha diaria.</p>
            </div>
        </div>
    </div>

</div>
