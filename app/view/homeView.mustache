<link rel="stylesheet" href="/public/css/home.css">

<div class="w3-content home" style="max-width:760px">

    <!-- Bienvenida y botón principal -->
    <div class="home-card home-hero w3-margin-top">
        <div class="home-icono">🧠</div>
        <h2>¡Hola{{#usuario}}, @{{usuario}}{{/usuario}}!</h2>
        <p class="home-subtitulo">Girá la ruleta y demostrá cuánto sabés.</p>
        {{#en_curso}}
            <p class="home-subtitulo">Tenés una partida en curso. ¡El reloj sigue corriendo!</p>
            <a href="/partida/pregunta" class="w3-button w3-green w3-large w3-round-large home-btn-jugar">▶ Continuar partida</a>
        {{/en_curso}}
        {{^en_curso}}
            <a href="/partida/iniciar" class="w3-button w3-green w3-large w3-round-large home-btn-jugar">Jugar</a>
        {{/en_curso}}
    </div>

    <!-- Cómo se juega -->
    <div class="home-card">
        <h4 class="home-titulo">¿Cómo se juega?</h4>
        <div class="home-pasos">
            <div class="home-paso">
                <span class="home-paso-num">1</span>
                <p>Girá la ruleta y te toca una categoría</p>
            </div>
            <div class="home-paso">
                <span class="home-paso-num">2</span>
                <p>Respondé en {{limite_segundos}} segundos: cada acierto suma 1 punto</p>
            </div>
            <div class="home-paso">
                <span class="home-paso-num">3</span>
                <p>Si te equivocás o se acaba el tiempo, la partida termina</p>
            </div>
        </div>
    </div>

</div>