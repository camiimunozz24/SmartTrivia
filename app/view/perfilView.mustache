<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">
<link rel="stylesheet" href="/public/css/login.css">
<link rel="stylesheet" href="/public/css/perfil.css">

<div class="w3-content perfil" style="max-width:760px">
    <div class="card-trivia-perfil w3-margin-top">

        {{#aviso}}
            <div class="w3-panel w3-pale-green w3-leftbar w3-border-green">
                <p>{{aviso}}</p>
            </div>
        {{/aviso}}

        <!-- Cabecera de Perfil -->
        <div class="perfil-cabecera">
            {{#tiene_foto}}
                <img src="/public/img/perfiles/{{foto_perfil}}" alt="Foto de {{nombre_completo}}" class="perfil-avatar">
            {{/tiene_foto}}
            {{^tiene_foto}}
                <div class="perfil-avatar-placeholder">👤</div>
            {{/tiene_foto}}

            <div class="perfil-titulos">
                <h2>{{nombre_completo}}</h2>
                <p class="perfil-subtitulo">@{{usuario}}</p>
                <span class="perfil-badge">
                    {{#es_propio}}★ Mi Perfil{{/es_propio}}
                    {{^es_propio}}Jugador{{/es_propio}}
                    • Miembro desde {{fecha_registro}}
                </span>
            </div>
        </div>

        {{#es_propio}}
            <div class="perfil-editar-caja" style="display:flex; flex-wrap:wrap; gap:10px; align-items:center;">
                <a href="/perfil/editar" class="perfil-editar">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 013 3L7 19l-4 1 1-4z"/></svg>
                    Editar perfil
                </a>
                {{#mostrar_panel_editor}}
                    <a href="/editor/show" class="w3-button w3-blue w3-round" style="text-decoration:none; font-weight:600; font-size:0.88rem;">
                        🛠️ Panel de editor
                    </a>
                {{/mostrar_panel_editor}}
                {{#mostrar_panel_admin}}
                    <a href="/admin/show" class="w3-button w3-red w3-round" style="text-decoration:none; font-weight:600; font-size:0.88rem;">
                        ⚙️ Panel de administración
                    </a>
                {{/mostrar_panel_admin}}
                {{#mostrar_panel_maestro}}
                    <a href="/maestro/show" class="w3-button w3-purple w3-round" style="text-decoration:none; font-weight:600; font-size:0.88rem;">
                        👑 Control maestro
                    </a>
                {{/mostrar_panel_maestro}}
            </div>
        {{/es_propio}}

        <!-- Estadísticas de Juego (Puntaje, Partidas, Correctas y Mayor Racha) -->
        <div class="perfil-stats">
            <div class="stat-card stat-puntos">
                <span class="stat-icono">🏆</span>
                <div class="stat-info">
                    <div class="stat-valor">{{puntaje_acumulado}} pts</div>
                    <div class="stat-label">Puntaje total</div>
                </div>
            </div>

            <div class="stat-card stat-partidas">
                <span class="stat-icono">🎮</span>
                <div class="stat-info">
                    <div class="stat-valor">{{partidas_jugadas}}</div>
                    <div class="stat-label">Partidas realizadas</div>
                </div>
            </div>

            <div class="stat-card" style="background:#f0fdf4; border:1px solid #bbf7d0;">
                <span class="stat-icono">✅</span>
                <div class="stat-info">
                    <div class="stat-valor">{{preguntas_correctas}}</div>
                    <div class="stat-label">Preguntas correctas</div>
                </div>
            </div>

            <div class="stat-card" style="background:#fef3c7; border:1px solid #fde68a;">
                <span class="stat-icono">⚡</span>
                <div class="stat-info">
                    <div class="stat-valor">{{mayor_racha}} seguidas</div>
                    <div class="stat-label">Mayor racha de aciertos</div>
                </div>
            </div>
        </div>

        <!-- Racha Diaria de Acceso -->
        <div class="racha-diaria-banner" style="background:#fffbeb; border:1px solid #fde68a; border-radius:10px; padding:14px 18px; margin-bottom:24px; display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:12px;">
            <div style="display:flex; align-items:center; gap:12px;">
                <span style="font-size:28px;">🔥</span>
                <div>
                    <strong style="color:#92400e; font-size:16px;">Racha de acceso diaria: {{racha_dias}} {{#tiene_racha_dias}}días{{/tiene_racha_dias}}{{^tiene_racha_dias}}días (¡jugá hoy para empezarla!){{/tiene_racha_dias}}</strong>
                    <p style="margin:2px 0 0; font-size:13px; color:#b45309;">Entrá cada día y acertá al menos una pregunta para potenciar tus puntos.</p>
                </div>
            </div>
            <span style="background:#f59e0b; color:#fff; padding:6px 14px; border-radius:20px; font-weight:700; font-size:14px;">
                Multiplicador: {{multiplicador}}
            </span>
        </div>

        <!-- Sección: Datos del Jugador -->
        <section class="seccion">
            <h4 class="seccion-titulo"><span class="seccion-icono">📋</span> Datos del jugador</h4>
            <ul class="lista-datos">
                <li class="dato-item">
                    <div class="dato-label">Nombre de usuario</div>
                    <div class="dato-valor">{{usuario}}</div>
                </li>
                <li class="dato-item">
                    <div class="dato-label">Correo electrónico</div>
                    <div class="dato-valor">{{email}}</div>
                </li>
                <li class="dato-item">
                    <div class="dato-label">Fecha de nacimiento</div>
                    <div class="dato-valor">{{fecha_nacimiento}} {{#edad}}({{edad}} años){{/edad}}</div>
                </li>
                <li class="dato-item">
                    <div class="dato-label">Género</div>
                    <div class="dato-valor">{{genero}}</div>
                </li>
                <li class="dato-item" style="grid-column: 1 / -1;">
                    <div class="dato-label">Ciudad y País</div>
                    <div class="dato-valor">📍 {{ciudad}}, {{pais}}</div>
                </li>
            </ul>
        </section>

        <!-- Sección: Ubicación en el mapa -->
        <section class="seccion">
            <h4 class="seccion-titulo"><span class="seccion-icono">🗺️</span> Ubicación</h4>
            <p style="margin: 0 0 10px; color: #555; font-size: 14px;">Ubicación registrada: <strong>{{ciudad}}, {{pais}}</strong></p>
            <div id="mapa-perfil"></div>
        </section>

        {{#puede_ver_historial}}
        <!-- Sección: Historial de Partidas (Privado: propio usuario o editor/admin/maestro) -->
        <section class="seccion">
            <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:8px;">
                <h4 class="seccion-titulo" style="margin:0;"><span class="seccion-icono">📜</span> Últimas partidas</h4>
                <a href="{{url_historial_completo}}" class="w3-button w3-blue w3-round w3-small" style="text-decoration:none; font-weight:600;">
                    {{#es_propio}}Ver tu historial completo{{/es_propio}}{{^es_propio}}Ver historial completo{{/es_propio}} →
                </a>
            </div>
            {{#tiene_historial}}
                <div class="tabla-responsive" style="overflow-x:auto;">
                    <table class="w3-table w3-striped w3-bordered" style="margin-top:8px;">
                        <thead>
                            <tr style="background:#f1f5f9; color:#475569; font-size:13px;">
                                <th>Fecha</th>
                                <th>Categoría</th>
                                <th>Puntos</th>
                                <th>Aciertos</th>
                                <th>Mayor Racha</th>
                                <th>Resultado</th>
                            </tr>
                        </thead>
                        <tbody>
                            {{#historial_partidas}}
                                <tr>
                                    <td style="font-size:13px; color:#64748b;">{{fecha}}</td>
                                    <td><span style="border-left:3px solid {{color}}; padding-left:6px; font-weight:500;">{{categoria}}</span></td>
                                    <td><strong style="color:#0f2a52;">+{{puntaje}}</strong></td>
                                    <td>✅ {{respuestas_correctas}}</td>
                                    <td>⚡ {{mejor_racha}}</td>
                                    <td><span class="w3-tag w3-round w3-light-gray" style="font-size:11px;">{{motivo_texto}}</span></td>
                                </tr>
                            {{/historial_partidas}}
                        </tbody>
                    </table>
                </div>
            {{/tiene_historial}}
            {{^tiene_historial}}
                <p style="color:#64748b; margin:8px 0 0; font-size:14px;">Todavía no hay partidas registradas.</p>
            {{/tiene_historial}}
        </section>
        {{/puede_ver_historial}}

        <!-- Sección: Código QR del perfil -->
        <section class="seccion" id="qr-perfil">
            <h4 class="seccion-titulo"><span class="seccion-icono">📱</span> Código QR del perfil</h4>
            <div class="qr-contenedor">
                <img src="{{qr_url}}" alt="QR para acceder al perfil de {{usuario}}" class="qr-imagen">
                <p class="qr-ayuda">
                    {{#es_propio}}Mostrale este código QR a otras personas: al escanearlo desde su celular pueden ver tu perfil, sin necesidad de iniciar sesión.{{/es_propio}}
                    {{^es_propio}}Escaneá este código QR desde tu celular para acceder directamente a este perfil.{{/es_propio}}
                </p>
               <!-- <small style="color:#888; word-break: break-all;">{{url_perfil}}</small> -->
            </div>
        </section>

    </div>
</div>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script>
    document.addEventListener("DOMContentLoaded", async () => {
        const mapa = L.map("mapa-perfil").setView([-34.6037, -58.3816], 5);
        L.tileLayer("https://tile.openstreetmap.org/{z}/{x}/{y}.png", {
            maxZoom: 18,
            attribution: "&copy; OpenStreetMap contributors"
        }).addTo(mapa);

        const ciudad = "{{ciudad}}";
        const pais = "{{pais}}";
        const nombre = "{{nombre_completo}}";

        if (ciudad || pais) {
            try {
                const query = encodeURIComponent(`${ciudad}, ${pais}`);
                const res = await fetch(`https://nominatim.openstreetmap.org/search?format=json&q=${query}&limit=1`);
                const data = await res.json();

                if (data && data.length > 0) {
                    const lat = parseFloat(data[0].lat);
                    const lon = parseFloat(data[0].lon);
                    mapa.setView([lat, lon], 12);
                    L.marker([lat, lon]).addTo(mapa)
                        .bindPopup(`<b>${nombre}</b><br>${ciudad}, ${pais}`)
                        .openPopup();
                }
            } catch (e) {
                console.log("No se pudo geocodificar la ubicación en el perfil:", e);
            }
        }
    });
</script>
